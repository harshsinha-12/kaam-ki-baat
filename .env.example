# Copy to .env.local. Never commit real values.
KKB_TOOL_KEY=            # Bearer key Bolna sends to /api/tools/* (long random string)
KKB_BOARD_KEY=           # key for the /?key=... evidence board
KKB_PUBLIC_URL=          # temporary HTTPS origin used by Bolna custom functions
GITHUB_TOKEN=            # server-only; optional for public repos, required for authorized private repo API reads
KKB_SNAPSHOT=            # optional override; default data/private/snapshot.json then data/demo/snapshot.fixture.json
KKB_EVENTS_FILE=         # optional; default data/runtime/events.jsonl
KKB_MCP_SESSION_TOKEN=   # optional private device session for local MCP tools; never NEXT_PUBLIC_

# Optional browser calls: configure only after agent/call authorization.
# Existing phone calls can use the spatial workspace without these values.
BOLNA_API_KEY=          # server-only; never NEXT_PUBLIC_
BOLNA_AGENT_ID=         # existing authorized agent with the spatial tools configured
KKB_ENABLE_WEB_CALLS=false

# WebAuthn: leave blank to use KKB_PUBLIC_URL (localhost fallback for development).
# Use a stable HTTPS origin for retained passkeys. RP ID is the hostname only.
KKB_ORIGIN=
KKB_RP_ID=
KKB_LEADER_STEPUP_SECRET= # server secret for the demo leader step-up code (replace with passkeys)
KKB_CALLBACK_KEY=         # Bearer key for /api/bolna/callback

# Optional local code graph built from the selected evidence snapshot.
# KKB_CODE_GRAPH=data/private/code-graph.json
# GRAPHIFY_BIN=/absolute/path/to/graphify

# Required on Vercel: persistent, server-only storage (Upstash Marketplace Redis).
# KV_REST_API_URL/TOKEN are accepted aliases. Never use NEXT_PUBLIC_ credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KKB_STORAGE_NAMESPACE=kaam-ki-baat
KKB_SNAPSHOT_KEY=        # immutable key returned by npm run storage:migrate
